{
  "name": "typescript-clean-architecture",
  "private": true,
  "scripts": {
    "prepare": "husky && turbo run @thaitype.com/mono#build --output-logs=errors-only",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!./tools/template",
    "lint:check": "turbo lint:check check-types && npm run format:check",
    "lint:fix": "turbo lint:fix && npm run format:fix",
    "format:check": "prettier --check ./**/*.{ts,tsx}",
    "format:fix": "prettier --write ./**/*.{ts,tsx}",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage-report": "turbo run view-report",
    "upgrade-deps": "npx taze --interactive",
    "check-deps": "npx taze"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "@thaitype/ioctopus": "^2.1.1",
    "tiny-glob": "^0.2.9"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@types/node": "^22.15.18",
    "@vitest/coverage-istanbul": "^3.0.9",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.4.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid"
  }
}